menu "epochtime"

    config QM_EPOCHTIME_SUPPORT
        bool "epochtime support"
        default n

    if QM_EPOCHTIME_SUPPORT

    choice
        prompt "choice method of getting time"
        default QM_TIME_NTP_SUPPORT

        config QM_TIME_NTP_SUPPORT
            bool "get time from ntp"

        config QM_TIME_LOCAL_SUPPORT
            bool "get time from local"
    endchoice

    if QM_TIME_NTP_SUPPORT

        config QM_ALI_NTP_SUPPORT
            bool "ali ntp"
            default y
        
        if QM_ALI_NTP_SUPPORT

            config QM_NTP_PORT
                int "ali ntp port"
                default 123
                range 1 65535
        endif

        config QM_TENCENT_NTP_SUPPORT
            bool "tencent ntp"
            default n

        if QM_TENCENT_NTP_SUPPORT

            config QM_TENCENT_NTP_PORT
                int "tecent ntp port"
                default 123
                range 1 65535
        endif

    endif


    if QM_TIME_LOCAL_SUPPORT


    endif

    endif

endmenu